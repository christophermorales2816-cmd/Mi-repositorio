{
  "manifest_version": 3,
  "name": "Clima CR — Provincias de Costa Rica",
  "version": "1.0.0",
  "description": "Pronóstico para las 7 provincias de Costa Rica.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clima CR",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "128": "icons/icon.svg"
  }
}